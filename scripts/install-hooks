#!/usr/bin/env bash
# Installs the local git hooks (idempotent). Hooks live in .git/hooks and are never tracked.
#   pre-commit : scripts/leak-check on the staged diff
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
hooks="$(git -C "$root" rev-parse --git-path hooks)"
[[ "$hooks" = /* ]] || hooks="$root/$hooks"
mkdir -p "$hooks"

install_hook() {
  local name="$1" body="$2" target="$hooks/$1"
  printf '%s\n' "$body" >"$target.tmp"
  chmod +x "$target.tmp"
  mv -f "$target.tmp" "$target"
  echo "installed $name"
}

install_hook pre-commit '#!/usr/bin/env bash
# managed by scripts/install-hooks
root="$(git rev-parse --show-toplevel)"
exec "$root/scripts/leak-check" --staged'

# Earlier versions installed a blocking pre-push hook; remove it if it is ours.
if grep -q 'managed by scripts/install-hooks' "$hooks/pre-push" 2>/dev/null; then
  rm -f "$hooks/pre-push"
  echo "removed pre-push"
fi
